# Copy to .env (never commit it). The bot and the web page should each get ONLY
# their own section in production; one shared .env is fine for local testing.
# Generate the keys with:  python -m scripts.generate_keys

# ── shared ───────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://verify.example.com
# Just the database NAME, not the connection string
MONGO_DB=verify

# ── bot (python -m bot.main) ─────────────────────────────────────────────────
DISCORD_TOKEN=
# The full connection string. For Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGO_URI_BOT=mongodb://verify_bot:CHANGE_ME@127.0.0.1:27017/verify?authSource=verify
MASTER_KEYS=
JOB_PRIVATE_KEY=
# Set to 1 the first time (or after changing commands) to register slash commands.
SYNC_COMMANDS=1
# Optional retention overrides (days)
# MEMBER_RETENTION_DAYS=180
# LEFT_RETENTION_DAYS=30
# DELETE_GRACE_DAYS=7
# SHARD_COUNT=

# ── web page (gunicorn "web.app:create_app()") ───────────────────────────────
# For local testing this can be the same string as MONGO_URI_BOT
MONGO_URI_WEB=mongodb://verify_web:CHANGE_ME@127.0.0.1:27017/verify?authSource=verify
JOB_PUBLIC_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Defaults to the host of PUBLIC_BASE_URL
# TURNSTILE_HOSTNAME=verify.example.com
# tunnel = Cloudflare Tunnel on this machine (recommended, no open ports)
# direct = Cloudflare connects to this server's public IP
PROXY_MODE=tunnel
# CLOUDFLARE_IPS_FILE=/etc/verify/cloudflare-ips.txt
VPN_CHECK=on
IP2PROXY_DB=/opt/verify/IP2PROXY-LITE-PX2.BIN

# ── local testing only ───────────────────────────────────────────────────────
# PROXY_MODE=insecure-dev
# I_UNDERSTAND_THIS_IS_INSECURE=1
# ALLOW_HTTP_BASE_URL=1
# VPN_CHECK=off
# Cloudflare's always-pass test keys:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
